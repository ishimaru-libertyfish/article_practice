<h1>投稿詳細</h1>

<p>
    <strong>タイトル：</strong>
    <%= @article.title %>
</p>

<p>
    <strong>投稿内容：</strong>
    <%= @article.content %>
</p>

<div>
    <%= link_to "投稿編集へ遷移", edit_article_path(@article) %> |
    <%= link_to "一覧画面へ戻る", articles_path %>

    <%= button_to "削除ボタン", @article, method: :delete, data: { turbo_confirm: "本当に削除しますか？" } %>
</div>